# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Higgsfield API credentials — get yours at https://cloud.higgsfield.ai/api-keys
# Format is KEY_ID:KEY_SECRET (combined with a colon, no spaces)
HIGGSFIELD_API_KEY=your_key_id:your_key_secret

# Optional: restrict which origins can call the API routes
NEXT_PUBLIC_APP_URL=http://localhost:3000
