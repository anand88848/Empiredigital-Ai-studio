# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Higgsfield AI — get credentials at https://cloud.higgsfield.ai/api-keys
# Format: KEY_ID:KEY_SECRET
HIGGSFIELD_CREDENTIALS=your_key_id:your_key_secret

# Optional: restrict which origins can call the API routes
NEXT_PUBLIC_APP_URL=http://localhost:3000
